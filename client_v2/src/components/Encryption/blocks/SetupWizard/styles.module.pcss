.header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0 16px;
}

.wizardTitle {
    margin: 0;
    padding: 8px 0;
    font-weight: var(--weight-bold);
    font-size: 24px;
    line-height: 28px;
    color: var(--default-main-text);
}

.wizardDescription {
    padding: 0 0 16px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--default-main-text);
}

.goBack {
    border: none;
    padding: 0;
    background: transparent;
    color: var(--default-link);
    font-size: 14px;
    line-height: 1.3;
    white-space: nowrap;
    cursor: pointer;
    font-family: inherit;
}

.steps {
    display: flex;
    flex: 1 0 0;
    gap: 4px;
}

/* Gap between the paste field and the dropzone below it. */
.dropzoneGap {
    margin-top: 16px;
}

.pill {
    flex: 1 0 0;
    height: 4px;
    border-radius: 8px;
    background: var(--gray-30);

    &_active {
        background: var(--product-primary-50);
    }
}

.footer {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;

    & button {
        width: 100%;
    }

    @media (min-width: 768px) {
        flex-wrap: nowrap;

        & button {
            width: auto;
        }
    }
}

.content {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

/* Inline per-field validation messages (Figma AGDNS-4262).  Only rendered for
   warnings and form-level messages: field errors use the controls'
   `errorMessage`, which also paints the field border red. */
.message {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.4;
}

.messageError {
    color: var(--default-error-icon);
}

.messageWarning {
    color: var(--default-attention-link);
}

.messageHint {
    padding-top: 4px;
    color: var(--default-description-text);
}
